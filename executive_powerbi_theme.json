{
  "name": "ExecutiveTalentAnalytics",
  "dataColors": [
    "#1E3A8A",
    "#2563EB",
    "#0D9488",
    "#EF4444",
    "#F59E0B",
    "#10B981",
    "#64748B",
    "#94A3B8"
  ],
  "background": "#F8FAFC",
  "foreground": "#0F172A",
  "tableAccent": "#1E293B",
  "visualStyles": {
    "*": {
      "*": {
        "outlines": [
          {
            "color": "#E2E8F0",
            "weight": 1
          }
        ],
        "dropShadow": [
          {
